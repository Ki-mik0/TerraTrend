{
  "name": "earthtrend-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:gen": "openapi-typescript ../contract/openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "api:check": "openapi-typescript ../contract/openapi.json -o src/api/schema.d.ts --default-non-nullable false --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
